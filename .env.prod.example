# 生产环境配置模板 — 华为云 RDS PostgreSQL 主备 + 华为云 DCS Redis 3.0 主备
#
# 使用方式：
#   cp .env.prod.example .env.prod  （然后替换所有 <占位符> 为真实值）
#   docker compose --env-file .env.prod up -d
#
# 说明：
#   postgres 容器有 profiles: [local]，生产启动时不会启动 postgres 容器
#   redis 容器同样有 profiles: [local]，生产不启动，改连华为云 DCS
#   本文件提交到 git；.env.prod 本身不提交（已加入 .gitignore）

# PostgreSQL — 华为云 RDS 主备版
# 注意事项：
#   1. 华为云 RDS 强制 SSL，连接串末尾必须加 ?sslmode=require
#   2. 华为云控制台数据库名不允许中划线，使用下划线：new_api
#   3. 密码中若含 @ 需编码为 %40；+ 号可直接使用无需编码
#   4. 生成密码建议：openssl rand -base64 24（避免 @ 字符）
SQL_DSN=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_HOST>:5432/new_api?sslmode=require

# Redis — 华为云 DCS Redis 3.0 主备版（控制台「连接信息」里的 IP 地址，端口固定 6379）
# 注意事项：
#   1. DCS 实例必须与 BMS 在同一 VPC、同一子网；安全组入方向放行 TCP 6379（源地址填 BMS 内网 IP/32 或所在子网）
#   2. 连接实例的 IP 地址或连接地址（写地址），不要用只读地址；主备切换后 IP 和域名都不变
#   3. 密码需做 URL 编码，可用：python3 -c 'import urllib.parse,getpass;print(urllib.parse.quote(getpass.getpass(),safe=""))'
#   4. 代码须兼容 Redis 3.0，见 AGENTS.md「Rule 8」
#   5. 只存可再生缓存（限流计数、审核/素材 ID 缓存、令牌/用户缓存），无需开启自动备份
REDIS_CONN_STRING=redis://:<DCS_PASSWORD_URL编码>@<DCS_IP>:6379/0

# Session 密钥 — 必须固定，重启容器后保持不变，否则所有用户需重新登录
# 生成方式：openssl rand -hex 32
SESSION_SECRET=<openssl rand -hex 32 生成的值>

# Watchtower 在线升级令牌 — 与 docker-compose.yml 中 WATCHTOWER_HTTP_API_TOKEN 一致
# 生成方式：openssl rand -hex 32
WATCHTOWER_API_TOKEN=<openssl rand -hex 32 生成的值>

# 节点名 — 多节点部署时每台填不同值，用于审计日志区分来源
NODE_NAME=new-api-node-1

# 反向代理子网 — WAF/Nginx 所在子网 CIDR，用于从 X-Forwarded-For 获取用户真实 IP
# 多个子网用逗号分隔，留空则不信任任何代理（直连部署时留空）
TRUSTED_PROXY_CIDR=10.0.0.0/24

# 端口绑定地址 — 生产环境通过安全组/WAF 控制访问来源时设为 0.0.0.0
# 本地开发默认 127.0.0.1（docker-compose.yml 中已设默认值，此行可省略）
BIND_HOST=0.0.0.0

# Streaming 无响应超时（秒）— 上游 AI 停止返回 token 后等待多久断开
# 默认 120s；接入 DeepSeek R1 等深度思考模型时建议设为 300
STREAMING_TIMEOUT=300

# 优雅退出的收尾总预算（秒）— docker-compose.yml 已默认 8，通常**不用动**。
# 含义：收到 SIGTERM 后，最多花这么久「等在途请求结束 → 强关 → 刷批量额度/看板增量 → 排空审核日志」。
# 为什么默认 8 而不是 300：docker stop / compose / watchtower 停容器默认只给 10s 就 SIGKILL，
# 而刷库那几步排在等在途请求之后 —— 预算超出这个窗口就等于那几步永远不执行（收尾形同虚设）。
# 想给它更长预算，必须同时把容器侧的 SIGKILL 窗口一起放大：
#   compose 加 stop_grace_period；K8s(CCE) 用 terminationGracePeriodSeconds（那边是 340s/320s）。
# 新窗口必须 ≥ 本值 + 5s，否则会被提前 SIGKILL。
# 相关日志：graceful shutdown: in-flight requests drained / moderation log queue drained
# SHUTDOWN_TIMEOUT=8

# KYC 加密 key（AES-256-GCM）— 生产必须独立生成，绝不复用 dev 值
# 生成方式：openssl rand -hex 32（两个 key 分别生成，互相独立）
KYC_ENCRYPT_KEY=<openssl rand -hex 32 生成的值>
KYC_HASH_KEY=<openssl rand -hex 32 生成的值>

# 内容审核原文留存 key（AES-256-GCM）— 同样独立生成，不复用上面两个
# 不设置时内容审核照常运行，但被拦请求只留 160 字符预览、不留完整原文，
# 事后无法复核；且补配只对之后发生的拦截生效，救不回已经丢掉的内容
MODERATION_ENCRYPT_KEY=<openssl rand -hex 32 生成的值>
